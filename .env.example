# Copy this file to .env (which git ignores) and fill in your values. Never commit .env.
ASSISTANT_MODE=bedrock
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: any Bedrock model with tool use (Converse API) that your account can access
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
